{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeutech.cn/schemas/portal-projection-event-v1.json",
  "title": "YEUTECH durable portal projection event",
  "type": "object",
  "required": ["cursor", "type", "data"],
  "properties": {
    "cursor": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "type": { "enum": ["session.state", "message.upsert", "trajectory.upsert", "projection.meta", "context.receipt"] },
    "data": { "type": "object" },
    "recordedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "additionalProperties": false,
  "x-yeutech-stream-semantics": "Only durable events advance cursor. Ephemeral SSE events carry the latest durable cursor but are never inserted into replay storage."
}
